# Copy to .env if you need to change defaults (the API reads real environment variables).
# Every one of these is checked once at start-up: a misconfigured server refuses
# to start and says what is wrong, rather than failing later under load.

DATABASE_URL=postgres://food:food@localhost:5433/food_delivery
PORT=3001

# Signs the session cookie. The value below is published in this repository, so
# in production it is not a secret at all: anyone holding it could sign a token
# for any account. The server refuses to start with it when NODE_ENV=production,
# and requires at least 32 characters there.
#   openssl rand -base64 48
JWT_SECRET=change-me-in-real-deployments

# Where the browser loads the site from. Used for the links in password-reset
# messages; in development the link is returned in the answer instead.
SITE_URL=http://localhost:3000

# production turns on Secure cookies, hides reset links from the answer, and
# makes the two checks above strict.
# NODE_ENV=production
